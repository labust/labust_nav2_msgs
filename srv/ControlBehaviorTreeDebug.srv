uint8 TICK=0
uint8 TICK_UNTIL_NODE_STARTS=1
uint8 CONTINUE=2
uint8 STOP=3
uint8 ADD_BREAKPOINT=4
uint8 REMOVE_BREAKPOINT=5
uint8 SET_BLACKBOARD_OVERRIDES=6

string deployment_id
uint8 command
string node_path
string[] breakpoint_paths
# JSON object used only by SET_BLACKBOARD_OVERRIDES. Values are primitive JSON
# values; null removes the corresponding blackboard key.
string blackboard_json
---
bool accepted
bool paused
string pause_path
string[] active_breakpoint_paths
string error_message
